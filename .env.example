# Copy to ".env" in the project root. Do not commit .env.
# Use SPRING_* / AWS_* names below — Docker passes these into the backend container.

# MongoDB Atlas
SPRING_DATA_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.YOUR_CLUSTER.mongodb.net/connecthub?retryWrites=true&w=majority&appName=Cluster0

# JWT
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_EXPIRATION=86400000

# AWS S3
AWS_S3_ENABLED=true
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_USE_OBJECT_ACL=false

# LiveKit (backend — keys must match LIVEKIT_KEYS in docker-compose.yml: "devkey: secret")
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend (embedded at "docker compose build" for the frontend image)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_LIVEKIT_URL=ws://localhost:7880
